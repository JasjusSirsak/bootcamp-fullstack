<!-- KARTU PROFIL -->
<div class="profile-card"
     data-name="<%= user.name %>"
     data-phone="<%= user.phone %>"
     data-email="<%= user.email || '-' %>"
     data-created="<%= user.created_at || '' %>"
     data-role="<%= user.role || 'User' %>"
     data-status="<%= user.status || 'Aktif' %>"
     onclick="openModal(this)">

  <div class="card-image-wrapper">
    <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=<%= encodeURIComponent(user.name) %>" alt="<%= user.name %>">
  </div>

  <div class="card-content">
    <div class="name-row">
      <h3><%= user.name %></h3>
      <i data-lucide="badge-check" class="badge-icon"></i>
      <span class="status-badge <%= (user.status === 'Nonaktif') ? 'status-off' : 'status-on' %>">
        <%= user.status || 'Aktif' %>
      </span>
    </div>
    <p class="subtitle"><i data-lucide="shield" style="width:14px;"></i> <%= user.role || 'User' %></p>
    <p class="subtitle"><i data-lucide="mail" style="width:14px;"></i> <%= user.email || '-' %></p>
    <p class="subtitle"><i data-lucide="phone" style="width:14px;"></i> <%= user.phone %></p>
  </div>
</div>
